  "serialize": [
    {
      "name": "all fields emit in canonical order",
      "options": {
        "comments": ["Security contact", "Managed by the security team"],
        "contact": ["mailto:a@example.com", "https://example.com/report"],
        "expires": "{{within_one_year}}",
        "acknowledgments": [
          "https://example.com/thanks/one",
          "https://example.com/thanks/two"
        ],
        "canonical": "https://example.com/.well-known/security.txt",
        "csaf": "https://example.com/csaf/provider-metadata.json",
        "encryption": "openpgp4fpr:0123456789ABCDEF",
        "hiring": "https://example.com/jobs",
        "policy": "https://example.com/policy",
        "preferredLanguages": ["en", "tr"]
      },
      "expected": "# Security contact\n# Managed by the security team\nContact: mailto:a@example.com\nContact: https://example.com/report\nExpires: {{within_one_year}}\nAcknowledgments: https://example.com/thanks/one\nAcknowledgments: https://example.com/thanks/two\nCanonical: https://example.com/.well-known/security.txt\nCSAF: https://example.com/csaf/provider-metadata.json\nEncryption: openpgp4fpr:0123456789ABCDEF\nHiring: https://example.com/jobs\nPolicy: https://example.com/policy\nPreferred-Languages: en, tr\n"
    },
    {
      "name": "scalar and array inputs preserve order",
      "options": {
        "contact": ["tel:+1-201-555-0123", "https://example.com/report"],
        "expires": "{{within_one_year}}",
        "policy": ["https://example.com/first", "https://example.com/second"],
        "preferredLanguages": "en-US"
      },
      "expected": "Contact: tel:+1-201-555-0123\nContact: https://example.com/report\nExpires: {{within_one_year}}\nPolicy: https://example.com/first\nPolicy: https://example.com/second\nPreferred-Languages: en-US\n"
    },
    {
      "name": "invalid contact URI throws",
      "options": {
        "contact": "ftp://example.com/report",
        "expires": "{{within_one_year}}"
      },
      "throws": true
    },
    {
      "name": "invalid HTTPS-only field throws",
      "options": {
        "contact": "https://example.com/report",
        "expires": "{{within_one_year}}",
        "csaf": "http://example.com/provider-metadata.json"
      },
      "throws": true
    },
    {
      "name": "invalid language tag throws",
      "options": {
        "contact": "https://example.com/report",
        "expires": "{{within_one_year}}",
        "preferredLanguages": "en_US"
      },
      "throws": true
    },
    {
      "name": "expired timestamp throws",
      "options": {
        "contact": "https://example.com/report",
        "expires": "{{past}}"
      },
      "throws": true
    },
    {
      "name": "comment line injection throws",
      "options": {
        "comments": ["safe\nContact: tel:injected"],
        "contact": "https://example.com/report",
        "expires": "{{within_one_year}}"
      },
      "throws": true
    },
    {
      "name": "field line injection throws",
      "options": {
        "contact": "mailto:a@example.com\rExpires: injected",
        "expires": "{{within_one_year}}"
      },
      "throws": true
    },
    {
      "name": "missing required contact throws",
      "options": { "expires": "{{within_one_year}}" },
      "throws": true
    },
    {
      "name": "empty optional array throws",
      "options": {
        "contact": "https://example.com/report",
        "expires": "{{within_one_year}}",
        "policy": []
      },
      "throws": true
    },
    {
      "name": "serialized field above 2048 characters throws",
      "options": {
        "contact": "https://example.com/report",
        "expires": "{{within_one_year}}",
        "policy": {
          "parts": [
            { "text": "https://example.com/" },
            { "repeat": "x", "count": 2100 }
          ]
        }
      },
      "throws": true
    },
    {
      "name": "serialized output above 32768 bytes throws",
      "options": {
        "comments": [{ "parts": [{ "repeat": "x", "count": 32768 }] }],
        "contact": "https://example.com/report",
        "expires": "{{within_one_year}}"
      },
      "throws": true
    },
    {
      "name": "serialized output above 1000 lines throws",
      "options": {
        "comments": { "repeatArray": "x", "count": 999 },
        "contact": "https://example.com/report",
        "expires": "{{within_one_year}}"
      },
      "throws": true
    }
  ]
